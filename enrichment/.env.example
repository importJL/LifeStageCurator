# LifeStage Curator enrichment service configuration.
# Copy to `.env` (gitignored) and fill in real values.

# --- Inference provider (AI router) ---
# OpenRouter or any OpenAI-compatible router.
AI_ROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=stealth/union-alpha
# Use "openrouter" for real inference, or "mock" for offline local development.
AI_ROUTER_PROVIDER=openrouter
# Optional attribution headers required by some routers.
AI_ROUTER_APP_URL=http://localhost:3000
AI_ROUTER_APP_NAME=LifeStage Curator

# --- Enrichment behaviour ---
ENRICHMENT_TIMEOUT_SECONDS=30
AI_CALL_TIMEOUT_SECONDS=12
AI_MAX_RETRIES=4
USE_OFFLINE_LABELLING_DEFAULT=true
HTTP_FETCH_TIMEOUT_SECONDS=10
MAX_CONTENT_CHARS=20000

# --- Duplicate detection ---
DUPLICATE_STORE_PATH=data/enrichment.db
DUPLICATE_SIMILARITY_THRESHOLD=0.9
ENABLE_EMBEDDING_DUPLICATES=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Caching & cost controls ---
CACHE_TTL_SECONDS=3600
MAX_REQUESTS_PER_MINUTE=30
DAILY_TOKEN_BUDGET=200000
REQUEST_TOKEN_BUDGET=8000

# --- Observability ---
LOG_LEVEL=INFO
ENRICHMENT_LOG_PATH=data/enrichment-log.jsonl
